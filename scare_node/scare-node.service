[Unit]
Description=Halloween scare-node
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -m scare_node.main
WorkingDirectory=/opt/halloween
Environment=MQTT_HOST=homeassistant.local
# CHANGE per fysieke node: zone-a, zone-b, ... Twee nodes met dezelfde zone
# krijgen hetzelfde MQTT client-id en gooien elkaar er continu uit.
Environment=SCARE_ZONE=zone-a
Environment=SCARE_PIR_PIN=4
# LogsDirectory maakt /var/log/halloween aan met de juiste eigenaar.
Environment=LOG_DIR=/var/log/halloween
LogsDirectory=halloween
# StateDirectory maakt /var/lib/halloween aan met de juiste eigenaar; daar komt
# de mediacache (van de backend opgehaalde audio) te staan.
Environment=SCARE_MEDIA_CACHE_DIR=/var/lib/halloween/media_cache
StateDirectory=halloween
# CHANGE: point at your Plan 2 backend once it exists
Environment=BACKEND_URL=http://<backend-host>:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
