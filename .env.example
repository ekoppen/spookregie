# Kopieer dit naar .env en vul in voordat je `docker compose up -d --build` draait.

# Verplicht — geen standaardwaarde om veiligheidsredenen.
ADMIN_PASSWORD=verander-mij

# Je bestaande MQTT-broker (bijv. Home Assistant's Mosquitto-add-on).
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Home Assistant-koppeling (WLED-status/bediening). Leeg laten schakelt de
# proxy uit. HA_TOKEN is een long-lived access token uit je HA-profiel.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Poort op de Linux-server waarop de beheerpagina bereikbaar wordt.
ADMIN_PORT=8000

# URL van de mirror-node's eigen MJPEG-live-preview-endpoint. Wordt bij het
# BOUWEN in de frontend gebakken (Vite build-time var) — na een wijziging
# hier moet je `docker compose build` draaien, niet alleen `up`.
VITE_MIRROR_STREAM_URL=http://mirror-node.local:8091/stream
