[Unit]
Description=Halloween mirror-node
# graphical.target: de node heeft een draaiende X-sessie nodig (cv2.imshow
# op de beamer). Zonder display crasht de node direct en herstart systemd
# hem elke 3 seconden opnieuw.
After=network-online.target graphical.target
Wants=network-online.target

[Service]
# CHANGE per machine: de gebruiker die de desktop-/X-sessie draait.
User=halloween
ExecStart=/usr/bin/python3 -m mirror_node.main
WorkingDirectory=/opt/halloween
Environment=MQTT_HOST=homeassistant.local
# cv2.imshow heeft een X-display + autorisatie nodig; pas het pad aan als je
# User hierboven wijzigt.
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/halloween/.Xauthority
# LogsDirectory maakt /var/log/halloween aan met de juiste eigenaar.
Environment=LOG_DIR=/var/log/halloween
LogsDirectory=halloween
# StateDirectory maakt /var/lib/halloween aan met de juiste eigenaar; daar komt
# de mediacache (overlays) te staan.
Environment=MIRROR_MEDIA_CACHE_DIR=/var/lib/halloween/media_cache
StateDirectory=halloween
# Poort van de MJPEG-live-preview; moet bereikbaar zijn vanaf de browser die
# de beheerpagina draait.
Environment=MIRROR_STREAM_PORT=8091
# CHANGE: point at your Plan 2 backend once it exists
Environment=BACKEND_URL=http://<backend-host>:8000
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
